# =============================================================================
# CELESTECON 2026 ENVIRONMENT CONFIGURATION TEMPLATE
# DO NOT COMMIT REAL SECRETS TO REPOSITORY.
# Configure these variables in Cloudflare Pages / Vercel Project Settings.
# =============================================================================

# JotForm API Integration (Server-side Only)
JOTFORM_API_KEY=your_jotform_api_key_here
JOTFORM_FORM_ID=261896133006456
JOTFORM_API_BASE=https://api.jotform.com

# Firebase Cloud Vault Database (Optional Redundancy)
FIREBASE_DATABASE_URL=https://your-firebase-project-id.firebaseio.com

# Admin Authentication Secret (For Conclave Secretariat Gateway)
# Generate a high-entropy 64-char hex string: openssl rand -hex 32
ADMIN_SECRET_KEY=generate_high_entropy_secret_key_here

# Allowed CORS Origins (Comma-separated for strict origin checking)
ALLOWED_ORIGINS=https://celestecon.com,https://c26.pages.dev,https://aeross.org,http://localhost:5173

# Application Environment Mode
NODE_ENV=production
DEBUG=false
